# systemd unit for scribed (plan phase 5). The .deb / .rpm put it in /usr/lib/systemd/system/,
# scripts/install/linux.sh in /etc/systemd/system/; by hand:
#   systemctl daemon-reload && systemctl enable --now scribed
# The hardening options come later in plan phase 13.
[Unit]
Description=scribe outgoing connection tracker
Documentation=https://github.com/savex/scribe
After=network-online.target
Wants=network-online.target

[Service]
# scribed sends READY=1 once storage, the policy and the sensor are up, and STOPPING=1 on stop.
Type=notify
ExecStart=/usr/bin/scribed --config /etc/scribe/scribe.toml
# Re-read the config; settings that need a restart are logged.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
