# Lab targets for e2e traffic. Every value must point at a lab server; the scripts refuse to run
# while any is empty, so a run never reaches the public internet by accident.
#   TLS_HOST       HTTPS server learned in learn mode (stays quiet later)
#   TLS_HOST_NEW   HTTPS server first contacted in alert mode
#   PLAIN_HOST     plain HTTP server; PLAIN_PATH is requested from it
#   RAW_IP / RAW_PORT  an IP with no DNS name and a port outside policy.usual_ports
# Example values for a lab using documentation names:
#   TLS_HOST=tls.lab.example.net
TLS_HOST=
TLS_HOST_NEW=
PLAIN_HOST=
PLAIN_PATH=/download?id=42
RAW_IP=
RAW_PORT=8443
# Schema version the new package migrates to (SCHEMA_VERSION in scribe-storage-api).
SCHEMA_VERSION=2
