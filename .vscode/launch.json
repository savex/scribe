{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug scribed (daemon)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=scribed",
          "--package=scribe-daemon",
          "--all-features"
        ],
        "filter": {
          "name": "scribed",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      }
    },
    {
      "name": "Debug scribe (CLI) with arguments",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=scribe",
          "--package=scribe-cli"
        ],
        "filter": {
          "name": "scribe",
          "kind": "bin"
        }
      },
      "args": "${input:cliArgs}",
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      }
    },
    {
      "name": "Debug unit tests in a crate",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--lib",
          "--all-features",
          "--package=${input:package}"
        ],
        "filter": {
          "kind": "lib"
        }
      },
      "args": [
        "${input:testFilter}"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      }
    },
    {
      "name": "Debug a crate's functional tests",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--all-features",
          "--package=${input:package}",
          "--test=functional"
        ],
        "filter": {
          "name": "functional",
          "kind": "test"
        }
      },
      "args": [
        "${input:testFilter}",
        "--include-ignored"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1",
        "SCRIBE_TEST_POSTGRES_URL": "postgres://scribe:scribe@localhost:5432/scribe_test"
      }
    },
    {
      "name": "Debug smoke, integration or scenario tests",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--all-features",
          "--package=scribe-tests",
          "--test=${input:suite}"
        ],
        "filter": {
          "name": "${input:suite}",
          "kind": "test"
        }
      },
      "args": [
        "${input:testFilter}"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      }
    },
    {
      "name": "Debug gen-fixtures",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin=gen-fixtures",
          "--package=scribe-test-support"
        ],
        "filter": {
          "name": "gen-fixtures",
          "kind": "bin"
        }
      },
      "args": [
        "--check"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      }
    }
  ],
  "inputs": [
    {
      "id": "cliArgs",
      "type": "promptString",
      "description": "Arguments for scribe (e.g. --version, mode caution, hosts)",
      "default": "--version"
    },
    {
      "id": "package",
      "type": "pickString",
      "description": "Crate whose tests to debug",
      "options": [
        "scribe-alerts",
        "scribe-api",
        "scribe-cli",
        "scribe-core",
        "scribe-daemon",
        "scribe-enrich",
        "scribe-module-api",
        "scribe-module-conformance",
        "scribe-module-url",
        "scribe-net",
        "scribe-policy",
        "scribe-process",
        "scribe-secrets",
        "scribe-sensor-conformance",
        "scribe-sensor-linux",
        "scribe-sensor-pcap",
        "scribe-sensor-windows",
        "scribe-storage-api",
        "scribe-storage-conformance",
        "scribe-storage-manager",
        "scribe-storage-postgres",
        "scribe-storage-sqlite",
        "scribe-test-support"
      ],
      "default": "scribe-enrich"
    },
    {
      "id": "suite",
      "type": "pickString",
      "description": "Test suite of scribe-tests (workfiles/test-list.md)",
      "options": [
        "smoke",
        "integration",
        "scenario"
      ],
      "default": "smoke"
    },
    {
      "id": "testFilter",
      "type": "promptString",
      "description": "Only run tests whose name contains this (empty = all)",
      "default": ""
    }
  ]
}
